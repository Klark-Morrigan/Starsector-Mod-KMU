#!/usr/bin/env bash
# Auto-fixes what this repo's commits need fixing: the executable bit on staged
# files that must carry it - *.sh, the gradlew wrappers, the .githooks/ scripts
# - and trailing whitespace in staged Markdown and Gradle scripts.
#
# Which fixes a commit gets, and the order they run in, live in
# Common-Automation's .github/lib/run-pre-commit-fixes.sh (sibling checkout),
# shared so every repo in the family fixes a commit the same way. What stays
# here is only what this repo alone knows: where its siblings are, which paths
# it needs +x on, and which tier it belongs to.
#
# Activated by running scripts/setup-hooks.sh once after cloning.

set -euo pipefail

hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "${hook_dir}/.." && pwd)"
shared_fixes="${repo_root}/../Common-Automation/.github/lib/run-pre-commit-fixes.sh"

# Skipped rather than fatal when the sibling is not checked out. These fixes
# are conveniences: a hook that aborted here would block every commit in a repo
# that is otherwise perfectly able to build, which is a far worse failure than
# a commit that keeps a line of trailing whitespace.
if [[ ! -f "${shared_fixes}" ]]; then
    echo "pre-commit: Common-Automation is not checked out beside this repo - skipping the staged fixes"
    exit 0
fi

# shellcheck source=/dev/null
source "${shared_fixes}"

# The +x set mirrors scripts/fix-permissions.sh: .sh anywhere, gradlew (root or
# nested), and anything under .githooks/, the last two having no extension to
# be recognised by. The types file is the JVM tier's declaration of .gradle as
# a text type, read from the Common-Java checkout this mod already builds
# against; it is honoured when present and ignored when not.
run_pre_commit_fixes \
    '(\.sh$|(^|/)gradlew$|^\.githooks/)' \
    "${repo_root}/../Common-Java/.github/lib/trimmed-file-types.sh"
