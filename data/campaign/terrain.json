{
	# A purely-visual terrain whose renderOnMap paints the sector map's layers -
	# whichever map layer the player has selected. Terrain is the only surface
	# the sector map invokes for custom world-space drawing (the nebulae use the
	# same hook). The type ids are serialised into saves; a rename needs the
	# sweep in KMU_ModPlugin to retire the entity an existing save still holds
	# under the old id.
	"kmu_sector_map_layer_terrain":{
		"plugin":"kmu.maplayers.base.render.SectorMapLayerTerrainPlugin",
	},
	# The Starscape half of the pair. The map widget skips every terrain while
	# the Starscape filter is on except one whose entity reports the terrain
	# type "slipstream", so a second entity reports that and resolves its
	# plugin from this row; the plugin subclasses the one above and stands
	# aside whenever no Starscape map is on screen, leaving exactly one of the
	# two painting in any frame.
	"kmu_sector_map_layer_starscape_terrain":{
		"plugin":"kmu.maplayers.base.render.SectorMapLayerStarscapeTerrainPlugin",
	},
	# The upper half of the Starscape surface. The map's own per-system nebula
	# icons are drawn between the terrain icons it holds, so the parts of the
	# overlay that must not be fogged - the faction names - are emitted from a
	# second Starscape entity whose icon is lifted past them. Same entity class and same
	# whitelisted reported type as the row above; only the plugin differs, and all
	# it differs in is which band it paints.
	"kmu_sector_map_layer_above_starscape_nebulae_terrain":{
		"plugin":"kmu.maplayers.base.render.SectorMapLayerAboveStarscapeNebulaeTerrainPlugin",
	},
}
