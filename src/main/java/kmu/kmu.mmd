flowchart LR
    subgraph Meta["Notes / Legend"]
        direction TB
        ThinPlugin["Thin entry point<br/>wires runtime pieces"]
        PackageRules["Feature packages<br/>own behavior"]
        SharedRule["Shared utilities<br/>avoid package cycles"]
        Legend["Legend:<br/>blue = entry/orchestration<br/>green = core/domain/model<br/>pink = shared utility<br/>yellow = note"]
    end

    subgraph Entry["Entry / Wiring"]
        direction TB
        Plugin["KMU_ModPlugin"]
    end

    subgraph Features["Feature Packages"]
        direction TB
        UI["kmu.ui"]
        Conditions["kmu.conditions"]
        Console["kmu.console"]
    end

    subgraph Shared["Shared Utilities"]
        direction TB
        Reporter["KmuErrorReporter"]
    end

    ThinPlugin -. describes .-> Plugin
    PackageRules -. describes .-> UI
    PackageRules -. describes .-> Conditions
    PackageRules -. describes .-> Console
    SharedRule -. describes .-> Reporter
    Legend -. explains colors .-> Plugin

    Plugin -. later wires .-> UI

    Console -->|opens editor through| UI
    UI -->|uses services| Conditions
    UI -->|reports failures| Reporter

    Conditions -->|reports failures| Reporter
    Console -->|reports command failures| Reporter

    classDef note fill:#fff7d6,stroke:#b58b00,color:#242424
    classDef legend fill:#ffffff,stroke:#9ca3af,color:#242424
    classDef orchestration fill:#e8f1ff,stroke:#2f67b1,color:#0f2747
    classDef core fill:#e9f8ef,stroke:#2b8a4b,color:#10351d
    classDef value fill:#eef8ff,stroke:#3b82a0,color:#113247
    classDef port fill:#fff0e6,stroke:#c76a24,color:#4a2108
    classDef adapter fill:#f3ecff,stroke:#7b55b7,color:#2d1c45
    classDef external fill:#f3f4f6,stroke:#6b7280,color:#1f2937
    classDef shared fill:#ffeaf4,stroke:#c75186,color:#4a1830

    class ThinPlugin,PackageRules,SharedRule note
    class Legend legend
    class Plugin orchestration
    class UI,Conditions,Console core
    class Reporter shared
