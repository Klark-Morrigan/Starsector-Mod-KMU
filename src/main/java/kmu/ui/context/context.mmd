flowchart LR
    subgraph Meta["Notes / Legend"]
        direction TB
        ContextNote["Resolved market plus<br/>optional panel"]
        ResolverNote["Tries live public campaign<br/>context sources first"]
        TrackerNote["Tracks core UI market<br/>open events for notification paths"]
        FailureNote["Failures report and<br/>return empty context"]
        OwnershipNote["No ownership filtering<br/>in detection"]
        Legend["Legend:<br/>cyan = value/context<br/>orange = port/interface<br/>purple = adapter<br/>gray = external API<br/>pink = shared utility"]
    end

    subgraph Values["Context Values"]
        direction TB
        Context["KmuMarketUiContext"]
        Source["KmuMarketUiContextSource"]
    end

    subgraph Ports["Ports / Interfaces"]
        direction TB
        ResolverPort["KmuMarketUiContextResolver"]
    end

    subgraph Adapters["Starsector Adapters"]
        direction TB
        StarsectorResolver["StarsectorMarketUiContextResolver"]
        ContextTracker["StarsectorMarketUiContextTracker"]
    end

    subgraph Shared["Shared Utilities"]
        direction TB
        Reporter["KmuErrorReporter"]
    end

    subgraph External["External Starsector API"]
        direction TB
        SectorAPI["SectorAPI"]
        CampaignUIAPI["CampaignUIAPI"]
        InteractionDialogAPI["InteractionDialogAPI"]
        CampaignFleetAPI["CampaignFleetAPI"]
        ListenerManagerAPI["ListenerManagerAPI"]
        CoreUITabListener["CoreUITabListener"]
        CoreUITabId["CoreUITabId"]
        SectorEntityToken["SectorEntityToken"]
        MarketAPI["MarketAPI"]
        UIPanelAPI["UIPanelAPI"]
    end

    ContextNote -. describes .-> Context
    ResolverNote -. describes .-> StarsectorResolver
    TrackerNote -. describes .-> ContextTracker
    FailureNote -. describes .-> Reporter
    OwnershipNote -. constrains .-> Context
    Legend -. explains colors .-> Context

    StarsectorResolver -. implements .-> ResolverPort
    StarsectorResolver -->|reads sector state| SectorAPI
    StarsectorResolver -->|finds current dialog| CampaignUIAPI
    StarsectorResolver -->|reads target| InteractionDialogAPI
    StarsectorResolver -->|reads fallback target| CampaignFleetAPI
    StarsectorResolver -->|reads tracked market from| ListenerManagerAPI
    StarsectorResolver -->|extracts market from| SectorEntityToken
    StarsectorResolver -->|reports failures| Reporter
    StarsectorResolver -->|returns| Context

    ContextTracker -. implements .-> CoreUITabListener
    ContextTracker -->|observes opening tab| CoreUITabId
    ContextTracker -->|extracts market from| MarketAPI
    ContextTracker -->|extracts market from| SectorEntityToken

    ResolverPort -->|returns optional| Context
    Context -->|records source| Source
    Context -->|contains market| MarketAPI
    Context -->|optionally contains panel| UIPanelAPI

    classDef note fill:#fff7d6,stroke:#b58b00,color:#242424
    classDef legend fill:#ffffff,stroke:#9ca3af,color:#242424
    classDef orchestration fill:#e8f1ff,stroke:#2f67b1,color:#0f2747
    classDef core fill:#e9f8ef,stroke:#2b8a4b,color:#10351d
    classDef value fill:#eef8ff,stroke:#3b82a0,color:#113247
    classDef port fill:#fff0e6,stroke:#c76a24,color:#4a2108
    classDef adapter fill:#f3ecff,stroke:#7b55b7,color:#2d1c45
    classDef external fill:#f3f4f6,stroke:#6b7280,color:#1f2937
    classDef shared fill:#ffeaf4,stroke:#c75186,color:#4a1830

    class ContextNote,ResolverNote,TrackerNote,FailureNote,OwnershipNote note
    class Legend legend
    class Context,Source value
    class ResolverPort port
    class StarsectorResolver,ContextTracker adapter
    class SectorAPI,CampaignUIAPI,InteractionDialogAPI,CampaignFleetAPI,ListenerManagerAPI,CoreUITabListener,CoreUITabId,SectorEntityToken,MarketAPI,UIPanelAPI external
    class Reporter shared
