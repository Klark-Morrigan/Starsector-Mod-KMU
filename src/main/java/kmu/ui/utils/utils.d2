# Style conventions: see ../../DIAGRAMS.md

direction: right

classes: {
  note: {
    style: {
      fill: "#fff7d6"
      stroke: "#b58b00"
      font-color: "#242424"
    }
  }
  shared: {
    style: {
      fill: "#ffeaf4"
      stroke: "#c75186"
      font-color: "#4a1830"
    }
  }
}

Legend: {
  grid-rows: 1
  L_shared: "shared utility" {class: shared}
  L_note: "note" {class: note}
}

Utils: "UI Utilities" {
  direction: down
  Highlights: "KmuHighlights" {class: shared}
  UtilsNote: "parallel list of highlight\ntokens and their colors" {class: note}
}
