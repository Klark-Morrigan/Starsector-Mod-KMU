# Style conventions: see ../../DIAGRAMS.md

direction: right

classes: {
  note: {
    style: {
      fill: "#fff7d6"
      stroke: "#b58b00"
      font-color: "#242424"
    }
  }
  value: {
    style: {
      fill: "#eef8ff"
      stroke: "#3b82a0"
      font-color: "#113247"
    }
  }
}

Legend: {
  grid-rows: 1
  L_value: "value / result" {class: value}
  L_note: "note" {class: note}
}

Geometry: "UI Geometry Values" {
  direction: down
  Placement: "KmuUiPlacement" {class: value}
  Size: "KmuUiSize" {class: value}
  GeometryNote: "immutable position and size;\nno Starsector API dependency" {class: note}
}
