flowchart LR
    subgraph Meta["Notes / Legend"]
        direction TB
        ScopeNote["Chooser overview only<br/>subpackage diagrams hold detail"]
        StyleNote["Style reference:<br/>kmu/diagram-style.md"]
        BoundaryNote["Chooser depends on<br/>conditions and Starsector UI"]
        Legend["Legend:<br/>blue = UI orchestration<br/>green = model/action<br/>orange = port/interface<br/>purple = adapter<br/>gray = external API"]
    end

    subgraph Root["Chooser Root"]
        direction TB
        Editor["KmuConditionChooserEditor"]
    end

    subgraph Action["action"]
        direction TB
        ActionLayer["Action handling<br/>and feedback result"]
    end

    subgraph Model["model"]
        direction TB
        ModelLayer["Chooser view model<br/>and model factory"]
    end

    subgraph Dialog["dialog"]
        direction TB
        DialogLayer["Dialog lifecycle<br/>and opener adapter"]
    end

    subgraph Render["render"]
        direction TB
        RenderLayer["Icon grid<br/>and in-place updates"]
    end

    subgraph Tooltip["tooltip"]
        direction TB
        TooltipLayer["Live vanilla tooltip<br/>adapter"]
    end

    subgraph External["External Layers"]
        direction TB
        Conditions["kmu.conditions"]
        EditorPort["kmu.ui.editor.KmuConditionEditor"]
        Context["kmu.ui.context.KmuMarketUiContext"]
        StarsectorUI["Starsector UI API"]
    end

    ScopeNote -. describes .-> Root
    StyleNote -. describes .-> Legend
    BoundaryNote -. constrains .-> Editor
    Legend -. explains colors .-> Editor

    Editor -. implements .-> EditorPort
    Editor -->|receives context| Context
    Editor -->|creates action session| ActionLayer
    Editor -->|opens dialog| DialogLayer

    ActionLayer -->|mutates via| Conditions
    ActionLayer -->|refreshes| ModelLayer
    DialogLayer -->|renders| RenderLayer
    DialogLayer -->|dispatches user actions| ActionLayer
    DialogLayer -->|uses| StarsectorUI
    RenderLayer -->|reads entries| ModelLayer
    RenderLayer -->|requests tooltips| TooltipLayer
    TooltipLayer -->|delegates to| StarsectorUI

    classDef note fill:#fff7d6,stroke:#b58b00,color:#242424
    classDef legend fill:#ffffff,stroke:#9ca3af,color:#242424
    classDef orchestration fill:#e8f1ff,stroke:#2f67b1,color:#0f2747
    classDef core fill:#e9f8ef,stroke:#2b8a4b,color:#10351d
    classDef port fill:#fff0e6,stroke:#c76a24,color:#4a2108
    classDef adapter fill:#f3ecff,stroke:#7b55b7,color:#2d1c45
    classDef external fill:#f3f4f6,stroke:#6b7280,color:#1f2937

    class ScopeNote,StyleNote,BoundaryNote note
    class Legend legend
    class Editor,DialogLayer,RenderLayer orchestration
    class ActionLayer,ModelLayer core
    class EditorPort port
    class TooltipLayer adapter
    class Conditions,Context,StarsectorUI external
