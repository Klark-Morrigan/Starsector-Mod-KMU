    classDef core fill:#e9f8ef,stroke:#2b8a4b,color:#10351d
    classDef value fill:#eef8ff,stroke:#3b82a0,color:#113247
    classDef port fill:#fff0e6,stroke:#c76a24,color:#4a2108
    classDef adapter fill:#f3ecff,stroke:#7b55b7,color:#2d1c45
    classDef external fill:#f3f4f6,stroke:#6b7280,color:#1f2937
    classDef shared fill:#ffeaf4,stroke:#c75186,color:#4a1830

    class ModelNote,DialogNote,StepNote note
    class Legend legend
    class ChooserEditor,ActionHandler,DialogDelegate orchestration
    class ModelFactory,Model,Entry,EntryState,Action,Feedback,ConditionService core
    class EditorPort,DialogOpener,EditableMarket port
    class StarsectorEditableMarket adapter
    class Context,CustomDialogDelegate,CustomPanelAPI,TooltipMakerAPI external
