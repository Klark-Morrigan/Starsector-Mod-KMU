flowchart LR
    subgraph Meta["Notes / Legend"]
        direction TB
        ModelNote["Plain Java model<br/>stays unit-testable"]
        DialogNote["Dialog delegate is<br/>Starsector UI boundary"]
        StepNote["Click-to-add<br/>belongs to Step 5"]
        Legend["Legend:<br/>blue = UI orchestration<br/>green = model/core behavior<br/>orange = port/interface<br/>purple = adapter<br/>gray = external API"]
    end

    subgraph Orchestration["UI Orchestration"]
        direction TB
        ChooserEditor["KmuConditionChooserEditor"]
        ActionHandler["KmuConditionChooserActionHandler"]
        DialogDelegate["KmuConditionChooserDialogDelegate"]
    end

    subgraph ModelLayer["Chooser Model"]
        direction TB
        ModelFactory["KmuConditionChooserModelFactory"]
        Model["KmuConditionChooserModel"]
        Entry["KmuConditionChooserEntry"]
        EntryState["KmuConditionChooserEntryState"]
        Action["KmuConditionChooserAction"]
        Feedback["KmuConditionChooserFeedback"]
        ConditionService["KmuConditionService"]
    end

    subgraph Ports["Ports / Interfaces"]
        direction TB
        EditorPort["KmuConditionEditor"]
        DialogOpener["KmuConditionChooserDialogOpener"]
        EditableMarket["KmuEditableMarket"]
    end

    subgraph Adapters["Adapters"]
        direction TB
        StarsectorEditableMarket["StarsectorEditableMarket"]
    end

    subgraph External["External / Other Layers"]
        direction TB
        Context["KmuMarketUiContext"]
        CustomDialogDelegate["CustomDialogDelegate"]
        CustomPanelAPI["CustomPanelAPI"]
        TooltipMakerAPI["TooltipMakerAPI"]
    end

    ModelNote -. describes .-> Model
    DialogNote -. describes .-> DialogDelegate
    StepNote -. constrains .-> DialogOpener
    Legend -. explains colors .-> ChooserEditor

    ChooserEditor -. implements .-> EditorPort
    ChooserEditor -->|receives market| Context
    ChooserEditor -->|creates action session with| ActionHandler
    ChooserEditor -->|opens dialog through| DialogOpener
    ChooserEditor -->|wraps market as| StarsectorEditableMarket

    ActionHandler -->|builds model with| ModelFactory
    ActionHandler -->|adds condition through| ConditionService
    ActionHandler -->|refreshes| Model
    ActionHandler -->|records| Feedback
    ActionHandler -->|handles| Action

    ModelFactory -->|queries state via| ConditionService
    ModelFactory -->|reads current ids| EditableMarket
    ModelFactory -->|creates| Model

    Model -->|contains| Entry
    Entry -->|has state| EntryState
    Action -->|targets| Entry

    DialogOpener -->|opens| DialogDelegate
    DialogDelegate -. implements .-> CustomDialogDelegate
    DialogDelegate -->|renders| Model
    DialogDelegate -->|dispatches actions to| ActionHandler
    DialogDelegate -->|shows| Feedback
    DialogDelegate -->|creates panel in| CustomPanelAPI
    DialogDelegate -->|adds rows/tooltips with| TooltipMakerAPI

