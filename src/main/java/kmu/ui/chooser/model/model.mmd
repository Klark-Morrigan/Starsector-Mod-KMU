flowchart LR
    subgraph Meta["Notes / Legend"]
        direction TB
        ScopeNote["Model layer is<br/>plain Java view state"]
        FactoryNote["Factory translates<br/>market/spec data to entries"]
        TooltipNote["Entries may carry<br/>optional tooltip renderer"]
        Legend["Legend:<br/>green = model behavior<br/>orange = port/interface<br/>purple = adapter<br/>gray = external layer"]
    end

    subgraph ModelLayer["Model Layer"]
        direction TB
        Factory["KmuConditionChooserModelFactory"]
        Model["KmuConditionChooserModel"]
        Entry["KmuConditionChooserEntry"]
        State["KmuConditionChooserEntryState"]
    end

    subgraph Dependencies["Dependencies"]
        direction TB
        Service["KmuConditionService"]
        Market["KmuEditableMarket"]
        StarsectorMarket["StarsectorEditableMarket"]
        TooltipRenderer["KmuConditionTooltipRenderer"]
        StarsectorTooltipRenderer["StarsectorConditionTooltipRenderer"]
    end

    ScopeNote -. describes .-> Model
    FactoryNote -. describes .-> Factory
    TooltipNote -. describes .-> Entry
    Legend -. explains colors .-> Factory

    Factory -->|lists visible specs| Service
    Factory -->|reads current ids| Market
    Factory -->|optionally reads live condition| StarsectorMarket
    Factory -->|creates| Model
    Model -->|contains| Entry
    Entry -->|has| State
    Entry -->|may carry| TooltipRenderer
    StarsectorTooltipRenderer -. implements .-> TooltipRenderer

    classDef note fill:#fff7d6,stroke:#b58b00,color:#242424
    classDef legend fill:#ffffff,stroke:#9ca3af,color:#242424
    classDef core fill:#e9f8ef,stroke:#2b8a4b,color:#10351d
    classDef port fill:#fff0e6,stroke:#c76a24,color:#4a2108
    classDef adapter fill:#f3ecff,stroke:#7b55b7,color:#2d1c45
    classDef external fill:#f3f4f6,stroke:#6b7280,color:#1f2937

    class ScopeNote,FactoryNote,TooltipNote note
    class Legend legend
    class Factory,Model,Entry,State core
    class Market,TooltipRenderer port
    class StarsectorMarket,StarsectorTooltipRenderer adapter
    class Service external
