flowchart LR
    subgraph Meta["Notes / Legend"]
        direction TB
        ScopeNote["Tooltip layer adapts<br/>live vanilla condition plugins"]
        SectionNote["Section helper renders<br/>metadata/status banners"]
        FallbackNote["Render layer appends<br/>status and metadata sections"]
        SafetyNote["Tooltip failures<br/>must fail closed"]
        ColorNote["Section styles group<br/>raw UI colors"]
        Legend["Legend:<br/>blue = helper<br/>orange = port/interface<br/>purple = adapter<br/>gray = external API"]
    end

    subgraph TooltipLayer["Tooltip Layer"]
        direction TB
        TooltipPort["KmuConditionTooltipRenderer"]
        StarsectorRenderer["StarsectorConditionTooltipRenderer"]
        TooltipSection["KmuTooltipSection"]
        TooltipSectionStyle["KmuTooltipSectionStyle"]
        StarsectorUiColorProvider["StarsectorUiColorProvider"]
        StarsectorUiColor["StarsectorUiColor"]
    end

    subgraph External["External Starsector API"]
        direction TB
        MarketConditionAPI["MarketConditionAPI"]
        MarketConditionPlugin["MarketConditionPlugin"]
        TooltipMakerAPI["TooltipMakerAPI"]
    end

    ScopeNote -. describes .-> TooltipPort
    SectionNote -. describes .-> TooltipSection
    FallbackNote -. constrains .-> TooltipMakerAPI
    SafetyNote -. constrains .-> StarsectorRenderer
    ColorNote -. describes .-> TooltipSectionStyle
    Legend -. explains colors .-> TooltipPort

    StarsectorRenderer -. implements .-> TooltipPort
    StarsectorRenderer -->|wraps| MarketConditionAPI
    StarsectorRenderer -->|delegates createTooltip to| MarketConditionPlugin
    StarsectorRenderer -->|writes into| TooltipMakerAPI
    TooltipSection -->|uses colors from| TooltipSectionStyle
    TooltipSectionStyle -->|references raw colors| StarsectorUiColor
    StarsectorUiColorProvider -->|resolves| StarsectorUiColor
    TooltipSection -->|writes section heading into| TooltipMakerAPI

    classDef note fill:#fff7d6,stroke:#b58b00,color:#242424
    classDef legend fill:#ffffff,stroke:#9ca3af,color:#242424
    classDef port fill:#fff0e6,stroke:#c76a24,color:#4a2108
    classDef helper fill:#e8f1ff,stroke:#2f67b1,color:#0f2747
    classDef adapter fill:#f3ecff,stroke:#7b55b7,color:#2d1c45
    classDef external fill:#f3f4f6,stroke:#6b7280,color:#1f2937

    class ScopeNote,SectionNote,FallbackNote,SafetyNote,ColorNote note
    class Legend legend
    class TooltipPort port
    class TooltipSection,TooltipSectionStyle,StarsectorUiColorProvider,StarsectorUiColor helper
    class StarsectorRenderer adapter
    class MarketConditionAPI,MarketConditionPlugin,TooltipMakerAPI external
