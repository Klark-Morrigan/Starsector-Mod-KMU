flowchart LR
    subgraph Meta["Notes / Legend"]
        direction TB
        ScopeNote["Action layer owns<br/>click result handling"]
        NoUiNote["No rendering code<br/>belongs here"]
        FeedbackNote["Feedback is a port<br/>reported outside the grid"]
        Legend["Legend:<br/>green = action/model behavior<br/>orange = port/interface<br/>gray = external layer"]
    end

    subgraph ActionLayer["Action Layer"]
        direction TB
        Action["KmuConditionChooserAction"]
        Handler["KmuConditionChooserActionHandler"]
        Feedback["KmuConditionChooserFeedback"]
        FeedbackSink["KmuConditionChooserFeedbackSink"]
        StarsectorFeedbackSink["StarsectorConditionChooserFeedbackSink"]
    end

    subgraph Dependencies["Dependencies"]
        direction TB
        Service["KmuConditionService"]
        Market["KmuEditableMarket"]
        ModelFactory["KmuConditionChooserModelFactory"]
        Model["KmuConditionChooserModel"]
        CampaignUI["CampaignUIAPI"]
    end

    ScopeNote -. describes .-> Handler
    NoUiNote -. constrains .-> Handler
    FeedbackNote -. describes .-> FeedbackSink
    Legend -. explains colors .-> Handler

    Action -->|captures condition id from| Model
    Handler -->|handles| Action
    Handler -->|adds condition through| Service
    Handler -->|uses target market| Market
    Handler -->|refreshes model through| ModelFactory
    Handler -->|stores| Feedback
    StarsectorFeedbackSink -. implements .-> FeedbackSink
    StarsectorFeedbackSink -->|writes campaign message| CampaignUI

    classDef note fill:#fff7d6,stroke:#b58b00,color:#242424
    classDef legend fill:#ffffff,stroke:#9ca3af,color:#242424
    classDef core fill:#e9f8ef,stroke:#2b8a4b,color:#10351d
    classDef port fill:#fff0e6,stroke:#c76a24,color:#4a2108
    classDef external fill:#f3f4f6,stroke:#6b7280,color:#1f2937

    class ScopeNote,NoUiNote,FeedbackNote note
    class Legend legend
    class Action,Handler,Feedback,ModelFactory,Model core
    class FeedbackSink port
    class Service,Market,CampaignUI external
    class StarsectorFeedbackSink port
