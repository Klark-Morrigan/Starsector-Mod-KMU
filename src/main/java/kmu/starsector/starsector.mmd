flowchart LR
    subgraph Meta["Notes / Legend"]
        direction TB
        ScopeNote["Shared Starsector wrappers<br/>for runtime-only APIs"]
        NamingNote["Use provider names:<br/>StarsectorUiColorProvider"]
        ColorNote["Enum entries name raw colors;<br/>component styles name purpose"]
        RuleNote["Feature code may depend on wrappers;<br/>core domain should not depend on Starsector"]
        Legend["Legend:<br/>purple = Starsector wrapper<br/>gray = Starsector API<br/>yellow = note"]
    end

    subgraph WrapperLayer["Starsector Wrapper Layer"]
        direction TB
        UiColors["StarsectorUiColorProvider"]
        UiColor["StarsectorUiColor"]
    end

    subgraph External["External Starsector API"]
        direction TB
        Misc["Misc UI colors"]
    end

    ScopeNote -. describes .-> UiColors
    NamingNote -. constrains .-> UiColors
    ColorNote -. describes .-> UiColor
    RuleNote -. constrains .-> UiColors
    Legend -. explains colors .-> UiColors

    UiColors -->|gets requested raw color| UiColor
    UiColor -->|may declare Starsector source| Misc
    UiColor -->|may declare custom color| UiColor

    classDef note fill:#fff7d6,stroke:#b58b00,color:#242424
    classDef legend fill:#ffffff,stroke:#9ca3af,color:#242424
    classDef adapter fill:#f3ecff,stroke:#7b55b7,color:#2d1c45
    classDef external fill:#f3f4f6,stroke:#6b7280,color:#1f2937

    class ScopeNote,NamingNote,ColorNote,RuleNote note
    class Legend legend
    class UiColors,UiColor adapter
    class Misc external
