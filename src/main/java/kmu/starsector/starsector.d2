# Style conventions: see ../DIAGRAMS.md

direction: right

classes: {
  note: {
    style: {
      fill: "#fff7d6"
      stroke: "#b58b00"
      font-color: "#242424"
    }
  }
  adapter: {
    style: {
      fill: "#f3ecff"
      stroke: "#7b55b7"
      font-color: "#2d1c45"
    }
  }
  external: {
    style: {
      fill: "#f3f4f6"
      stroke: "#6b7280"
      font-color: "#1f2937"
      stroke-dash: 5
    }
  }
}

Legend: {
  grid-rows: 1
  L_adapter: "adapter" {class: adapter}
  L_external: "external API" {class: external}
  L_note: "note" {class: note}
}

WrapperLayer: "Starsector Wrapper Layer" {
  direction: down
  UiColors: "StarsectorUiColorProvider" {class: adapter}
  UiColor: "StarsectorUiColor" {class: adapter}
  GravityWell: "StarsectorGravityWellResolver" {class: adapter}
  Relationship: "StarsectorPlayerRelationshipFormatter" {class: adapter}
  ScopeNote: "shared wrappers for runtime-only APIs;\nfeature code may depend on these;\ncore domain should not" {class: note}
  NamingNote: "use provider names:\nStarsectorUiColorProvider" {class: note}
}

External: "External Starsector API" {
  direction: down
  Misc: "Misc UI colors" {class: external}
  Market: "MarketAPI / entity orbit APIs" {class: external}
  Faction: "FactionAPI / RelationshipAPI" {class: external}
}

WrapperLayer.UiColors -> WrapperLayer.UiColor: "gets requested raw color"
WrapperLayer.UiColor -> External.Misc: "may declare Starsector source"
WrapperLayer.UiColor -> WrapperLayer.UiColor: "may declare custom color"
WrapperLayer.GravityWell -> External.Market: "walks orbit focuses"
WrapperLayer.Relationship -> External.Faction: "formats player relation"
WrapperLayer.Relationship -> External.Misc: "falls back to relation color"
