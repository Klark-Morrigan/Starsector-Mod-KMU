# Style conventions: see ../../DIAGRAMS.md

direction: right

classes: {
  note: {
    style: {
      fill: "#fff7d6"
      stroke: "#b58b00"
      font-color: "#242424"
    }
  }
  core: {
    style: {
      fill: "#e9f8ef"
      stroke: "#2b8a4b"
      font-color: "#10351d"
    }
  }
  value: {
    style: {
      fill: "#eef8ff"
      stroke: "#3b82a0"
      font-color: "#113247"
    }
  }
  port: {
    style: {
      fill: "#fff0e6"
      stroke: "#c76a24"
      font-color: "#4a2108"
    }
  }
  adapter: {
    style: {
      fill: "#f3ecff"
      stroke: "#7b55b7"
      font-color: "#2d1c45"
    }
  }
  shared: {
    style: {
      fill: "#ffeaf4"
      stroke: "#c75186"
      font-color: "#4a1830"
    }
  }
  external: {
    style: {
      fill: "#f3f4f6"
      stroke: "#6b7280"
      font-color: "#1f2937"
      stroke-dash: 5
    }
  }
}

Legend: {
  grid-rows: 1
  L_core: "core / domain" {class: core}
  L_value: "value / result" {class: value}
  L_port: "port / interface" {class: port}
  L_adapter: "adapter" {class: adapter}
  L_shared: "shared utility" {class: shared}
  L_external: "external API" {class: external}
  L_note: "note" {class: note}
}

Core: "Core Behavior" {
  direction: down
  Service: "KmuConditionService" {class: core}
  ServiceNote: "owns condition rules\nand failure behavior" {class: note}
}

Values: "Values / Results" {
  direction: down
  Spec: "KmuConditionSpec" {class: value}
  Result: "KmuConditionAddResult" {class: value}
  Status: "KmuConditionAddStatus" {class: value}
}

Ports: "Ports / Interfaces" {
  direction: down
  RepoPort: "KmuConditionRepository" {class: port}
  MarketPort: "KmuEditableMarket" {class: port}
  PortNote: "keep service testable\nwithout Starsector" {class: note}
}

Shared: "Shared Utilities" {
  direction: down
  Reporter: "KmuErrorReporter" {class: shared}
}

Adapters: "Starsector Adapters" {
  direction: down
  StarsectorRepo: "StarsectorConditionRepository" {class: adapter}
  StarsectorMarket: "StarsectorEditableMarket" {class: adapter}
  AdapterNote: "isolate Starsector API types" {class: note}
}

External: "External Starsector API" {
  direction: down
  SettingsAPI: "SettingsAPI" {class: external}
  MarketAPI: "MarketAPI" {class: external}
  MarketConditionSpecAPI: "MarketConditionSpecAPI" {class: external}
  MarketConditionAPI: "MarketConditionAPI" {class: external}
}

Core.Service -> Ports.RepoPort: "queries specs"
Core.Service -> Ports.MarketPort: "reads/mutates market"
Core.Service -> Shared.Reporter: "reports failures"
Core.Service -> Values.Spec: "lists specs"
Core.Service -> Values.Result: "returns add result"
Values.Result -> Values.Status: "has status"

Adapters.StarsectorRepo -> Ports.RepoPort: "implements" {
  style: { stroke-dash: 5 }
}
Adapters.StarsectorRepo -> External.SettingsAPI: "reads settings"
Adapters.StarsectorRepo -> External.MarketConditionSpecAPI: "maps from API spec"
Adapters.StarsectorRepo -> Values.Spec: "creates"

Adapters.StarsectorMarket -> Ports.MarketPort: "implements" {
  style: { stroke-dash: 5 }
}
Adapters.StarsectorMarket -> External.MarketAPI: "wraps"
Adapters.StarsectorMarket -> External.MarketConditionAPI: "marks surveyed"
