# Style conventions: see ../../../DIAGRAMS.md

direction: right

classes: {
  orchestration: {
    style: {
      fill: "#e8f1ff"
      stroke: "#2f67b1"
      font-color: "#0f2747"
    }
  }
  core: {
    style: {
      fill: "#e9f8ef"
      stroke: "#2b8a4b"
      font-color: "#10351d"
    }
  }
  value: {
    style: {
      fill: "#eef8ff"
      stroke: "#3b82a0"
      font-color: "#113247"
    }
  }
  port: {
    style: {
      fill: "#fff0e6"
      stroke: "#c76a24"
      font-color: "#4a2108"
    }
  }
  adapter: {
    style: {
      fill: "#f3ecff"
      stroke: "#7b55b7"
      font-color: "#2d1c45"
    }
  }
  external: {
    style: {
      fill: "#f3f4f6"
      stroke: "#6b7280"
      font-color: "#1f2937"
      stroke-dash: 5
    }
  }
}

Legend: {
  grid-rows: 1
  L_orch: "entry / orchestration" {class: orchestration}
  L_core: "core / domain" {class: core}
  L_value: "value / result" {class: value}
  L_port: "port / interface" {class: port}
  L_adapter: "adapter" {class: adapter}
  L_external: "external API" {class: external}
}

Entry: "Editor Implementation" {
  direction: down
  PickerEditor: "KmuConditionPickerEditor" {class: orchestration}
}

ActionLayer: "action" {
  direction: down
  ActionHandler: "KmuConditionPickerActionHandler" {class: orchestration}
  Action: "KmuConditionPickerAction" {class: core}
  FeedbackSink: "KmuConditionPickerFeedbackSink" {class: port}
  StarsectorFeedbackSink: "StarsectorConditionPickerFeedbackSink" {class: adapter}
}

DialogLayer: "dialog" {
  direction: down
  DialogDelegate: "KmuConditionPickerDialogDelegate" {class: orchestration}
  DialogOpener: "KmuConditionPickerDialogOpener" {class: port}
  StarsectorDialogOpener: "StarsectorInteractionDialogPickerOpener" {class: adapter}
}

ModelLayer: "model" {
  direction: down
  PickerModel: "KmuConditionPickerModel" {class: value}
}

RenderLayer: "render" {
  direction: down
  PickerContainer: "KmuConditionPickerContainer" {class: orchestration}
  PickerInfoRow: "KmuConditionPickerInfoRow" {class: adapter}
  IconGrid: "KmuConditionIconGrid" {class: value}
  IconButton: "KmuConditionIconButton" {class: value}
  IconButtonStyle: "KmuConditionIconButtonStyle" {class: core}
  LocationLabelSpecFactory: "KmuConditionPickerLocationLabelSpecFactory" {class: orchestration}
  SummaryLabelSpecFactory: "KmuConditionPickerSummaryLabelSpecFactory" {class: orchestration}
}

TooltipLayer: "tooltip" {
  direction: down
  EntryTooltipCreator: "KmuConditionEntryTooltipCreator" {class: adapter}
  TooltipRenderer: "KmuConditionTooltipRenderer" {class: port}
  StarsectorTooltipRenderer: "StarsectorConditionTooltipRenderer" {class: adapter}
}

External: "External Starsector API" {
  direction: down
  InteractionDialogAPI: "InteractionDialogAPI" {class: external}
  CampaignUIAPI: "CampaignUIAPI" {class: external}
  MarketConditionAPI: "MarketConditionAPI" {class: external}
  CustomPanelAPI: "CustomPanelAPI" {class: external}
  TooltipCreator: "TooltipMakerAPI.TooltipCreator" {class: external}
}

Entry.PickerEditor -> ActionLayer.ActionHandler: "creates"
Entry.PickerEditor -> DialogLayer.DialogOpener: "opens dialog via"

ActionLayer.ActionHandler -> ActionLayer.Action: "dispatches"
ActionLayer.ActionHandler -> ModelLayer.PickerModel: "refreshes"

ActionLayer.StarsectorFeedbackSink -> ActionLayer.FeedbackSink: "implements" {
  style: { stroke-dash: 5 }
}

DialogLayer.DialogDelegate -> ActionLayer.ActionHandler: "drives"
DialogLayer.DialogDelegate -> RenderLayer.PickerContainer: "renders via"
DialogLayer.DialogDelegate -> ActionLayer.FeedbackSink: "routes feedback to"

DialogLayer.StarsectorDialogOpener -> DialogLayer.DialogOpener: "implements" {
  style: { stroke-dash: 5 }
}
DialogLayer.StarsectorDialogOpener -> External.InteractionDialogAPI: "shows dialog"
DialogLayer.StarsectorDialogOpener -> External.CampaignUIAPI: "reads campaign UI"

RenderLayer.PickerContainer -> RenderLayer.LocationLabelSpecFactory: "queries location specs from"
RenderLayer.PickerContainer -> RenderLayer.SummaryLabelSpecFactory: "queries summary specs from"
RenderLayer.PickerContainer -> RenderLayer.PickerInfoRow: "renders info via"
RenderLayer.PickerContainer -> RenderLayer.IconGrid: "lays out"

RenderLayer.PickerInfoRow -> External.CustomPanelAPI: "creates sub-panels via"

RenderLayer.IconGrid -> RenderLayer.IconButton: "creates"
RenderLayer.IconButton -> RenderLayer.IconButtonStyle: "determines render style via"
RenderLayer.IconButton -> ActionLayer.Action: "dispatches"
RenderLayer.IconButton -> TooltipLayer.EntryTooltipCreator: "creates"

TooltipLayer.EntryTooltipCreator -> External.TooltipCreator: "implements" {
  style: { stroke-dash: 5 }
}
TooltipLayer.EntryTooltipCreator -> TooltipLayer.TooltipRenderer: "delegates to when present"

TooltipLayer.StarsectorTooltipRenderer -> TooltipLayer.TooltipRenderer: "implements" {
  style: { stroke-dash: 5 }
}
TooltipLayer.StarsectorTooltipRenderer -> External.MarketConditionAPI: "delegates to"
