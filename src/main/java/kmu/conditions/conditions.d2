# Style conventions: see ../DIAGRAMS.md

direction: right

classes: {
  note: {
    style: {
      fill: "#fff7d6"
      stroke: "#b58b00"
      font-color: "#242424"
    }
  }
  orchestration: {
    style: {
      fill: "#e8f1ff"
      stroke: "#2f67b1"
      font-color: "#0f2747"
    }
  }
  core: {
    style: {
      fill: "#e9f8ef"
      stroke: "#2b8a4b"
      font-color: "#10351d"
    }
  }
  value: {
    style: {
      fill: "#eef8ff"
      stroke: "#3b82a0"
      font-color: "#113247"
    }
  }
  adapter: {
    style: {
      fill: "#f3ecff"
      stroke: "#7b55b7"
      font-color: "#2d1c45"
    }
  }
}

Legend: {
  grid-rows: 1
  L_orch: "entry / orchestration" {class: orchestration}
  L_core: "core / domain" {class: core}
  L_value: "value / result" {class: value}
  L_adapter: "adapter" {class: adapter}
  L_note: "note" {class: note}
}

Domain: "domain layer" {
  direction: down
  DomainPkg: "kmu.conditions.domain" {class: core}
  LayerNote: "no UI dependency;\nUI layers depend on domain" {class: note}
}

UILayers: "UI layers" {
  direction: down
  Editor: "kmu.conditions.ui.editor" {class: orchestration}
  Picker: "kmu.conditions.ui.picker" {class: adapter}
  EditorNote: "editor orchestrates:\nvalidate, open, handle errors" {class: note}
  PickerNote: "picker is all UI:\ndialog, model, render, tooltips" {class: note}
}

SharedUI: "Shared UI Infrastructure" {
  direction: down
  Context: "kmu.ui.context" {class: value}
}

UILayers.Editor -> SharedUI.Context: "resolves context"
UILayers.Picker -> UILayers.Editor: "implements editor port" {
  style: { stroke-dash: 5 }
}
UILayers.Picker -> Domain.DomainPkg: "reads condition state"
UILayers.Picker -> SharedUI.Context: "uses market context"
