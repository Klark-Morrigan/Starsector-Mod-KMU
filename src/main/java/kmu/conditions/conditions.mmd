flowchart LR
    subgraph Meta["Notes / Legend"]
        direction TB
        ServiceNote["Owns condition rules<br/>and failure behavior"]
        PortNote["Ports keep service<br/>testable without Starsector"]
        AdapterNote["Adapters isolate<br/>Starsector API types"]
        Legend["Legend:<br/>green = core behavior<br/>cyan = value/result<br/>orange = port/interface<br/>purple = adapter<br/>gray = external API<br/>pink = shared utility"]
    end

    subgraph Core["Core Behavior"]
        direction TB
        Service["KmuConditionService"]
    end

    subgraph Values["Values / Results"]
        direction TB
        Spec["KmuConditionSpec"]
        Result["KmuConditionAddResult"]
        Status["KmuConditionAddStatus"]
    end

    subgraph Ports["Ports / Interfaces"]
        direction TB
        RepoPort["KmuConditionRepository"]
        MarketPort["KmuEditableMarket"]
    end

    subgraph Shared["Shared Utilities"]
        direction TB
        Reporter["KmuErrorReporter"]
    end

    subgraph Adapters["Starsector Adapters"]
        direction TB
        StarsectorRepo["StarsectorConditionRepository"]
        StarsectorMarket["StarsectorEditableMarket"]
    end

    subgraph External["External Starsector API"]
        direction TB
        SettingsAPI["SettingsAPI"]
        MarketAPI["MarketAPI"]
        MarketConditionSpecAPI["MarketConditionSpecAPI"]
        MarketConditionAPI["MarketConditionAPI"]
    end

    ServiceNote -. describes .-> Service
    PortNote -. describes .-> RepoPort
    AdapterNote -. describes .-> StarsectorRepo
    Legend -. explains colors .-> Service

    Service -->|queries specs| RepoPort
    Service -->|reads/mutates market| MarketPort
    Service -->|reports failures| Reporter
    Service -->|lists specs| Spec
    Service -->|returns add result| Result

    Result -->|has status| Status

    StarsectorRepo -. implements .-> RepoPort
    StarsectorRepo -->|reads settings| SettingsAPI
    StarsectorRepo -->|maps from API spec| MarketConditionSpecAPI
    StarsectorRepo -->|creates| Spec

    StarsectorMarket -. implements .-> MarketPort
    StarsectorMarket -->|wraps| MarketAPI
    StarsectorMarket -->|marks surveyed| MarketConditionAPI

    classDef note fill:#fff7d6,stroke:#b58b00,color:#242424
    classDef legend fill:#ffffff,stroke:#9ca3af,color:#242424
    classDef orchestration fill:#e8f1ff,stroke:#2f67b1,color:#0f2747
    classDef core fill:#e9f8ef,stroke:#2b8a4b,color:#10351d
    classDef value fill:#eef8ff,stroke:#3b82a0,color:#113247
    classDef port fill:#fff0e6,stroke:#c76a24,color:#4a2108
    classDef adapter fill:#f3ecff,stroke:#7b55b7,color:#2d1c45
    classDef external fill:#f3f4f6,stroke:#6b7280,color:#1f2937
    classDef shared fill:#ffeaf4,stroke:#c75186,color:#4a1830

    class ServiceNote,PortNote,AdapterNote note
    class Legend legend
    class Service core
    class Spec,Result,Status value
    class RepoPort,MarketPort port
    class Reporter shared
    class StarsectorRepo,StarsectorMarket adapter
    class SettingsAPI,MarketAPI,MarketConditionSpecAPI,MarketConditionAPI external
